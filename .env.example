# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/visitor_pass_db
# Set to true to run with an embedded in-memory MongoDB + auto-seeded demo data (no local mongod required)
USE_MEMORY_DB=false

# Security / JWT
JWT_SECRET=replace_with_a_strong_32_char_secret_key
JWT_EXPIRES_IN=7d
QR_SIGNING_SECRET=replace_with_a_qr_hmac_secret_key

# Email Notifications (SMTP via Nodemailer - optional; falls back to simulated NotificationLogs when blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GatePass VMS <noreply@gatepass-vms.local>"

# SMS Notifications (Twilio REST API - optional; falls back to simulated NotificationLogs when blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend (Vite)
VITE_API_URL=/api
